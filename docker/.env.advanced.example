# Database N8N
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=25432
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_SCHEMA=public

DB_POSTGRESDB_DATABASE_DB1=db1
DB_POSTGRESDB_USER_DB1=n8n_db1
DB_POSTGRESDB_PASSWORD_DB1=
DB_POSTGRESDB_SCHEMA_DB1=public

# Runtime
GENERIC_TIMEZONE=Europe/Amsterdam
NODE_ENV=production

# Web / security
N8N_SECURE_COOKIE=false
N8N_HOST=
WEBHOOK_URL=https://
N8N_EDITOR_BASE_URL=https://
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DIGEST_API_KEY=

# Task runners
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MODE=external
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM_32PLUS_CHARS
N8N_NATIVE_PYTHON_RUNNER=true

#runner 
N8N_RUNNERS_TASK_BROKER_URI=http://n8n:5679
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM_SECRET
N8N_RUNNERS_STDLIB_ALLOW=json,base64
N8N_RUNNERS_CONFIG_PATH=/etc/n8n-task-runners.json
