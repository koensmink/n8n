      "parameters": {
        "language": "pythonNative",
        "pythonCode": "import json\nimport base64\n\ndef normalize_nulls(x):\n    if x is None:\n        return None\n    s = str(x)\n    if s in (\"JsNull\", \"JsUndefined\", \"null\", \"undefined\"):\n        return None\n    if isinstance(x, dict):\n        return {k: normalize_nulls(v) for k, v in x.items()}\n    if isinstance(x, list):\n        return [normalize_nulls(v) for v in x]\n    return x\n\nitems = _items\nif not items:\n    raise ValueError(\"Geen input items ontvangen\")\n\ninner_data = items[0].get(\"json\", {}).get(\"item\")\ninner_data = normalize_nulls(inner_data)\n\nif inner_data is None:\n    raise ValueError(\"Geen 'json.item' gevonden in input\")\n\njson_string = json.dumps(inner_data, indent=4, ensure_ascii=False)\nbase64_string = base64.b64encode(json_string.encode(\"utf-8\")).decode(\"utf-8\")\n\nreturn [{\"json\": {\"item\": base64_string}}]"
